{
  "name": "mercurjs/magento2-connector",
  "description": "Sell Mercur marketplace offers from a Magento 2 storefront, next to your own products.",
  "type": "magento2-component",
  "version": "0.1.0",
  "license": "MIT",
  "homepage": "https://mercurjs.com",
  "support": {
    "issues": "https://github.com/mercurjs/magento2-connector/issues",
    "source": "https://github.com/mercurjs/magento2-connector"
  },
  "keywords": [
    "magento2",
    "magento2-module",
    "marketplace",
    "multi-vendor",
    "mercur",
    "medusa"
  ],
  "repositories": [
    {
      "type": "composer",
      "url": "https://mirror.mage-os.org/"
    }
  ],
  "require": {
    "php": ">=8.1",
    "magento/framework": "^103.0",
    "magento/module-catalog": "^104.0",
    "magento/module-checkout": "^100.4",
    "magento/module-quote": "^101.2",
    "magento/module-sales": "^103.0",
    "magento/module-shipping": "^100.4",
    "magento/module-store": "^101.1",
    "magento/module-backend": "^102.0",
    "magento/module-config": "^101.2",
    "magento/module-ui": "^101.2",
    "magento/module-cron": "^100.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "squizlabs/php_codesniffer": "^3.9"
  },
  "autoload": {
    "files": [
      "registration.php"
    ],
    "psr-4": {
      "Mercur\\Core\\": "Core/",
      "Mercur\\Process\\": "Process/",
      "Mercur\\Connector\\": "Connector/",
      "Mercur\\OfferIndexer\\": "OfferIndexer/",
      "Mercur\\Catalog\\": "Catalog/",
      "Mercur\\Settlement\\": "Settlement/",
      "Mercur\\Frontend\\": "Frontend/",
      "Mercur\\GraphQl\\": "GraphQl/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Mercur\\Test\\": "Test/"
    }
  },
  "scripts": {
    "lint": "find . -name '*.php' -not -path './vendor/*' -print0 | xargs -0 -n1 php -l > /dev/null",
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true
  }
}
