<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="mercur">
            <group id="catalog" translate="label" type="text" sortOrder="50" showInDefault="1">
                <label>Catalog</label>
                <field id="attribute_group" translate="label comment" type="text" sortOrder="10" showInDefault="1">
                    <label>Marketplace attribute group</label>
                    <comment>Attributes in this group of the attribute set are pushed to Mercur as global product attributes.</comment>
                </field>
                <field id="attribute_set_id" translate="label comment" type="text" sortOrder="20" showInDefault="1">
                    <label>Attribute set for imported products</label>
                    <comment>Default is 4 (the default set).</comment>
                </field>
                <field id="import_products" translate="label" type="select" sortOrder="30" showInDefault="1">
                    <label>Import published seller products</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="imported_product_status" translate="label" type="select" sortOrder="40" showInDefault="1">
                    <label>Status of imported products</label>
                    <source_model>Magento\Catalog\Model\Product\Attribute\Source\Status</source_model>
                </field>
                <field id="imported_product_visibility" translate="label" type="select" sortOrder="50" showInDefault="1">
                    <label>Visibility of imported products</label>
                    <source_model>Magento\Catalog\Model\Product\Visibility</source_model>
                </field>
                <field id="website_ids" translate="label comment" type="multiselect" sortOrder="60" showInDefault="1">
                    <label>Websites for imported products</label>
                    <source_model>Magento\Config\Model\Config\Source\Website</source_model>
                    <can_be_empty>1</can_be_empty>
                    <comment>Leave empty to use every website where the connector is enabled with a Mercur region.</comment>
                </field>
                <field id="import_images" translate="label comment" type="select" sortOrder="70" showInDefault="1">
                    <label>Import product images</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Downloads the Mercur product images into the media gallery of imported products. Images are matched by their source URL, so a re-run adds new ones, drops withdrawn ones and leaves images added in Magento alone.</comment>
                </field>
                <field id="image_max_size_mb" translate="label" type="text" sortOrder="80" showInDefault="1">
                    <label>Maximum image size (MB)</label>
                    <validate>validate-digits</validate>
                </field>
                <field id="image_timeout_sec" translate="label" type="text" sortOrder="90" showInDefault="1">
                    <label>Image download timeout (seconds)</label>
                    <validate>validate-digits</validate>
                </field>
            </group>
        </section>
    </system>
</config>
