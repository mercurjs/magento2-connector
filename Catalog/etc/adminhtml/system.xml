<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="mercur">
            <group id="catalog" translate="label" type="text" sortOrder="50" showInDefault="1">
                <label>Catalog</label>
                <field id="attribute_group" translate="label comment" type="text" sortOrder="10" showInDefault="1">
                    <label>Marketplace attribute group</label>
                    <comment>Attributes in this group of the attribute set are pushed to Mercur as global product attributes.</comment>
                </field>
                <field id="attribute_set_id" translate="label comment" type="text" sortOrder="20" showInDefault="1">
                    <label>Attribute set for imported products</label>
                    <comment>Default is 4 (the default set).</comment>
                </field>
                <field id="import_products" translate="label" type="select" sortOrder="30" showInDefault="1">
                    <label>Import published seller products</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="imported_product_status" translate="label" type="select" sortOrder="40" showInDefault="1">
                    <label>Status of imported products</label>
                    <source_model>Magento\Catalog\Model\Product\Attribute\Source\Status</source_model>
                </field>
                <field id="imported_product_visibility" translate="label" type="select" sortOrder="50" showInDefault="1">
                    <label>Visibility of imported products</label>
                    <source_model>Magento\Catalog\Model\Product\Visibility</source_model>
                </field>
            </group>
        </section>
    </system>
</config>
