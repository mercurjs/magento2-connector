<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="catalog_category_save_after">
        <observer name="mercur_push_category" instance="Mercur\Catalog\Observer\PushCategoryOnSave"/>
    </event>
    <event name="catalog_entity_attribute_save_after">
        <observer name="mercur_push_attribute" instance="Mercur\Catalog\Observer\PushCategoryOnSave"/>
    </event>
    <event name="catalog_product_save_after">
        <observer name="mercur_push_product" instance="Mercur\Catalog\Observer\PushProductOnSave"/>
    </event>
    <event name="catalog_product_delete_before">
        <observer name="mercur_archive_product" instance="Mercur\Catalog\Observer\ArchiveProductOnDelete"/>
    </event>
    <event name="mercur_offers_imported">
        <observer name="mercur_update_imported_stock" instance="Mercur\Catalog\Observer\UpdateImportedStock"/>
    </event>
</config>
