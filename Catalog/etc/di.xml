<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Mercur\Process\Model\TaskPool">
        <arguments>
            <argument name="tasks" xsi:type="array">
                <item name="products" xsi:type="object">Mercur\Catalog\Model\Task\ProductSync</item>
                <item name="taxonomy" xsi:type="object">Mercur\Catalog\Model\Task\TaxonomyPush</item>
            </argument>
        </arguments>
    </type>
    <type name="Mercur\Connector\Model\Task\FullSync">
        <arguments>
            <argument name="order" xsi:type="array">
                <item name="taxonomy" xsi:type="string">taxonomy</item>
                <item name="products" xsi:type="string">products</item>
            </argument>
        </arguments>
    </type>
    <type name="Mercur\Connector\Model\Webhook\Dispatcher">
        <arguments>
            <argument name="handlers" xsi:type="array">
                <item name="product.published" xsi:type="array">
                    <item name="sync" xsi:type="object">Mercur\Catalog\Model\Webhook\EnqueueProductSync</item>
                </item>
            </argument>
        </arguments>
    </type>
    <virtualType name="Mercur\Catalog\Model\Webhook\EnqueueProductSync" type="Mercur\Connector\Model\Webhook\Handler\EnqueueSync">
        <arguments>
            <argument name="task" xsi:type="string">products</argument>
        </arguments>
    </virtualType>
</config>
