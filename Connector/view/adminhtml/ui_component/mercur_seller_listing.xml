<?xml version="1.0"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">mercur_seller_listing.mercur_seller_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <spinner>mercur_seller_listing_columns</spinner>
        <deps>
            <dep>mercur_seller_listing.mercur_seller_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="mercur_seller_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">seller_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>Mercur_Core::sellers</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider" name="mercur_seller_listing_data_source">
            <settings>
                <requestFieldName>seller_id</requestFieldName>
                <primaryFieldName>seller_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filters name="listing_filters"/>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="mercur_seller_listing_columns">
        <column name="seller_id" sortOrder="10">
            <settings>
                <filter>text</filter>
                <label translate="true">Mercur ID</label>
            </settings>
        </column>
        <column name="name" sortOrder="20">
            <settings>
                <filter>text</filter>
                <label translate="true">Name</label>
            </settings>
        </column>
        <column name="handle" sortOrder="30">
            <settings>
                <filter>text</filter>
                <label translate="true">Handle</label>
            </settings>
        </column>
        <column name="status" sortOrder="40">
            <settings>
                <filter>text</filter>
                <label translate="true">Status</label>
            </settings>
        </column>
        <column name="premium" sortOrder="50">
            <settings>
                <filter>text</filter>
                <label translate="true">Premium</label>
            </settings>
        </column>
        <column name="city" sortOrder="60">
            <settings>
                <filter>text</filter>
                <label translate="true">City</label>
            </settings>
        </column>
        <column name="country_code" sortOrder="70">
            <settings>
                <filter>text</filter>
                <label translate="true">Country</label>
            </settings>
        </column>
        <column name="default_leadtime_to_ship" sortOrder="80">
            <settings>
                
                <label translate="true">Lead time (days)</label>
            </settings>
        </column>
        <column name="closed_from" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date" sortOrder="90">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Closed from</label>
            </settings>
        </column>
        <column name="closed_to" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date" sortOrder="100">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Closed to</label>
            </settings>
        </column>
        <column name="updated_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date" sortOrder="110">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Updated in Mercur</label>
            </settings>
        </column>
    </columns>
</listing>
