<?xml version="1.0"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">mercur_offer_listing.mercur_offer_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <spinner>mercur_offer_listing_columns</spinner>
        <deps>
            <dep>mercur_offer_listing.mercur_offer_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="mercur_offer_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">offer_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>Mercur_Core::offers</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider" name="mercur_offer_listing_data_source">
            <settings>
                <requestFieldName>offer_id</requestFieldName>
                <primaryFieldName>offer_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filters name="listing_filters"/>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="mercur_offer_listing_columns">
        <column name="offer_id" sortOrder="10">
            <settings>
                <filter>text</filter>
                <label translate="true">Mercur ID</label>
            </settings>
        </column>
        <column name="product_sku" sortOrder="20">
            <settings>
                <filter>text</filter>
                <label translate="true">SKU</label>
            </settings>
        </column>
        <column name="seller_sku" sortOrder="30">
            <settings>
                <filter>text</filter>
                <label translate="true">Seller SKU</label>
            </settings>
        </column>
        <column name="seller_name" sortOrder="40">
            <settings>
                <filter>text</filter>
                <label translate="true">Seller</label>
            </settings>
        </column>
        <column name="price" sortOrder="50">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Lowest price</label>
            </settings>
        </column>
        <column name="currency_code" sortOrder="60">
            <settings>
                
                <label translate="true">Currency</label>
            </settings>
        </column>
        <column name="website_count" sortOrder="70">
            <settings>
                
                <label translate="true">Websites</label>
            </settings>
        </column>
        <column name="quantity" sortOrder="80">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Available</label>
            </settings>
        </column>
        <column name="active" sortOrder="90">
            <settings>
                <filter>text</filter>
                <label translate="true">Active</label>
            </settings>
        </column>
        <column name="condition_code" sortOrder="100">
            <settings>
                <filter>text</filter>
                <label translate="true">Condition</label>
            </settings>
        </column>
        <column name="leadtime_to_ship" sortOrder="110">
            <settings>
                
                <label translate="true">Lead time (days)</label>
            </settings>
        </column>
        <column name="updated_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date" sortOrder="120">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Updated in Mercur</label>
            </settings>
        </column>
    </columns>
</listing>
