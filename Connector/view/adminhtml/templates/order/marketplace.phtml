<?php
/** @var \Mercur\Connector\Block\Adminhtml\Order\Marketplace $block */
/** @var \Magento\Framework\Escaper $escaper */

$order = $block->getOrder();
$rows = $block->getRows();
if (!$order || $rows === []) {
    return;
}
?>
<section class="admin__page-section mercur-order-marketplace">
    <div class="admin__page-section-title">
        <span class="title"><?= $escaper->escapeHtml(__('Marketplace')) ?></span>
    </div>
    <div class="admin__page-section-content">
        <p>
            <?= $escaper->escapeHtml(__('Mercur order group')) ?>:
            <strong><?= $escaper->escapeHtml((string) ($order->getData('mercur_order_group_id') ?: __('not created yet'))) ?></strong>
        </p>
        <?php if ($block->isShippingLocked()): ?>
            <div class="message message-notice">
                <?= $escaper->escapeHtml(__('Seller lines are shipped by their sellers. A Magento shipment is recorded for each fulfillment Mercur reports; they cannot be shipped from here.')) ?>
            </div>
        <?php endif; ?>
        <table class="data-table admin__table-primary">
            <thead>
                <tr>
                    <th><?= $escaper->escapeHtml(__('Seller')) ?></th>
                    <th><?= $escaper->escapeHtml(__('Seller order')) ?></th>
                    <th><?= $escaper->escapeHtml(__('Items')) ?></th>
                    <th><?= $escaper->escapeHtml(__('Seller shipping')) ?></th>
                    <th><?= $escaper->escapeHtml(__('Status')) ?></th>
                    <th><?= $escaper->escapeHtml(__('Tracking')) ?></th>
                </tr>
            </thead>
            <tbody>
                <?php foreach ($rows as $row): ?>
                    <tr>
                        <td><?= $escaper->escapeHtml($row['seller_name']) ?></td>
                        <td><?= $escaper->escapeHtml($row['seller_order_id']) ?></td>
                        <td>
                            <?php foreach ($row['items'] as $item): ?>
                                <div><?= $escaper->escapeHtml($item['sku']) ?> &times; <?= (float) $item['qty'] ?> — <?= $escaper->escapeHtml($block->getStatusLabel($item['status'])) ?></div>
                            <?php endforeach; ?>
                        </td>
                        <td>
                            <?= $escaper->escapeHtml($row['shipping_method']) ?>
                            <?php if ($row['shipping_amount'] > 0): ?>
                                (<?= /* @noEscape */ $order->formatBasePrice($row['shipping_amount']) ?>)
                            <?php endif; ?>
                        </td>
                        <td><?= $escaper->escapeHtml($block->getStatusLabel($row['status'])) ?></td>
                        <td>
                            <?php foreach ($row['tracks'] as $track): ?>
                                <div><?= $escaper->escapeHtml(trim($track['title'] . ' ' . $track['number'])) ?></div>
                            <?php endforeach; ?>
                        </td>
                    </tr>
                <?php endforeach; ?>
            </tbody>
        </table>
    </div>
</section>
