<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:DataObject/etc/fieldset.xsd">
    <scope id="global">
        <fieldset id="quote_convert_item">
            <field name="mercur_offer_id"><aspect name="to_order_item"/></field>
            <field name="mercur_seller_id"><aspect name="to_order_item"/></field>
            <field name="mercur_line_item_id"><aspect name="to_order_item"/></field>
        </fieldset>
        <fieldset id="sales_convert_quote">
            <field name="mercur_cart_id"><aspect name="to_order"/></field>
        </fieldset>
        <fieldset id="sales_convert_quote_address">
            <field name="mercur_shipping_amount"><aspect name="to_order"/></field>
            <field name="base_mercur_shipping_amount"><aspect name="to_order"/></field>
        </fieldset>
    </scope>
</config>
