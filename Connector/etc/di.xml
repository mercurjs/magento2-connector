<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Mercur\Process\Model\TaskPool">
        <arguments>
            <argument name="tasks" xsi:type="array">
                <item name="sellers" xsi:type="object">Mercur\Connector\Model\Task\SellerSync</item>
                <item name="offers" xsi:type="object">Mercur\Connector\Model\Task\OfferSync</item>
                <item name="order_retry" xsi:type="object">Mercur\Connector\Model\Task\OrderRetry</item>
                <item name="full" xsi:type="object">Mercur\Connector\Model\Task\FullSync</item>
            </argument>
        </arguments>
    </type>
    <type name="Mercur\Connector\Model\Task\FullSync">
        <arguments>
            <argument name="runner" xsi:type="object">Mercur\Process\Model\Runner\Proxy</argument>
            <argument name="order" xsi:type="array">
                <item name="sellers" xsi:type="string">sellers</item>
                <item name="offers" xsi:type="string">offers</item>
            </argument>
        </arguments>
    </type>
    <virtualType name="Mercur\Connector\Model\Webhook\Handler\EnqueueOfferSync" type="Mercur\Connector\Model\Webhook\Handler\EnqueueSync">
        <arguments>
            <argument name="task" xsi:type="string">offers</argument>
        </arguments>
    </virtualType>
    <virtualType name="Mercur\Connector\Model\Webhook\Handler\EnqueueSellerSync" type="Mercur\Connector\Model\Webhook\Handler\EnqueueSync">
        <arguments>
            <argument name="task" xsi:type="string">sellers</argument>
        </arguments>
    </virtualType>
    <type name="Mercur\Connector\Model\Webhook\Dispatcher">
        <arguments>
            <argument name="logger" xsi:type="object">Mercur\Core\Logger\Logger</argument>
            <argument name="handlers" xsi:type="array">
                <item name="offer.created" xsi:type="array">
                    <item name="sync" xsi:type="object">Mercur\Connector\Model\Webhook\Handler\EnqueueOfferSync</item>
                </item>
                <item name="offer.updated" xsi:type="array">
                    <item name="sync" xsi:type="object">Mercur\Connector\Model\Webhook\Handler\EnqueueOfferSync</item>
                </item>
                <item name="offer.deleted" xsi:type="array">
                    <item name="sync" xsi:type="object">Mercur\Connector\Model\Webhook\Handler\EnqueueOfferSync</item>
                </item>
                <item name="seller.updated" xsi:type="array">
                    <item name="sync" xsi:type="object">Mercur\Connector\Model\Webhook\Handler\EnqueueSellerSync</item>
                </item>
                <item name="seller.approved" xsi:type="array">
                    <item name="sync" xsi:type="object">Mercur\Connector\Model\Webhook\Handler\EnqueueSellerSync</item>
                </item>
                <item name="seller.suspended" xsi:type="array">
                    <item name="sync" xsi:type="object">Mercur\Connector\Model\Webhook\Handler\EnqueueSellerSync</item>
                </item>
                <item name="seller.unsuspended" xsi:type="array">
                    <item name="sync" xsi:type="object">Mercur\Connector\Model\Webhook\Handler\EnqueueSellerSync</item>
                </item>
                <item name="seller.terminated" xsi:type="array">
                    <item name="sync" xsi:type="object">Mercur\Connector\Model\Webhook\Handler\EnqueueSellerSync</item>
                </item>
                <item name="seller.unterminated" xsi:type="array">
                    <item name="sync" xsi:type="object">Mercur\Connector\Model\Webhook\Handler\EnqueueSellerSync</item>
                </item>
                <item name="order.canceled" xsi:type="array">
                    <item name="canceled" xsi:type="object">Mercur\Connector\Model\Webhook\Handler\OrderCanceled</item>
                </item>
                <item name="order.fulfillment_created" xsi:type="array">
                    <item name="fulfillment" xsi:type="object">Mercur\Connector\Model\Webhook\Handler\SyncFulfillment</item>
                </item>
                <item name="order.fulfillment_canceled" xsi:type="array">
                    <item name="fulfillment" xsi:type="object">Mercur\Connector\Model\Webhook\Handler\SyncFulfillment</item>
                </item>
                <item name="order.shipment_created" xsi:type="array">
                    <item name="fulfillment" xsi:type="object">Mercur\Connector\Model\Webhook\Handler\SyncFulfillment</item>
                </item>
                <item name="shipment.created" xsi:type="array">
                    <item name="fulfillment" xsi:type="object">Mercur\Connector\Model\Webhook\Handler\SyncFulfillment</item>
                </item>
                <item name="delivery.created" xsi:type="array">
                    <item name="fulfillment" xsi:type="object">Mercur\Connector\Model\Webhook\Handler\SyncFulfillment</item>
                </item>
                <item name="order.return_requested" xsi:type="array">
                    <item name="fulfillment" xsi:type="object">Mercur\Connector\Model\Webhook\Handler\SyncFulfillment</item>
                </item>
                <item name="order.return_received" xsi:type="array">
                    <item name="fulfillment" xsi:type="object">Mercur\Connector\Model\Webhook\Handler\SyncFulfillment</item>
                </item>
            </argument>
        </arguments>
    </type>
    <type name="Mercur\Connector\Controller\Webhook\Index">
        <arguments>
            <argument name="logger" xsi:type="object">Mercur\Core\Logger\Logger</argument>
        </arguments>
    </type>
    <type name="Mercur\Process\Model\HistoryCleaner">
        <arguments>
            <argument name="pruners" xsi:type="array">
                <item name="webhook_events" xsi:type="object">Mercur\Connector\Model\Webhook\EventLog</item>
            </argument>
        </arguments>
    </type>
    <type name="Mercur\Connector\Model\Task\OfferSync">
        <arguments>
            <argument name="logger" xsi:type="object">Mercur\Core\Logger\Logger</argument>
        </arguments>
    </type>
    <type name="Mercur\Connector\Observer\SendMarketplaceOrder">
        <arguments>
            <argument name="logger" xsi:type="object">Mercur\Core\Logger\Logger</argument>
        </arguments>
    </type>
    <type name="Mercur\Connector\Observer\CaptureMarketplacePayment">
        <arguments>
            <argument name="logger" xsi:type="object">Mercur\Core\Logger\Logger</argument>
        </arguments>
    </type>
    <type name="Mercur\Connector\Observer\CancelMarketplacePayment">
        <arguments>
            <argument name="logger" xsi:type="object">Mercur\Core\Logger\Logger</argument>
        </arguments>
    </type>
    <type name="Mercur\Connector\Model\Webhook\Handler\OrderCanceled">
        <arguments>
            <argument name="logger" xsi:type="object">Mercur\Core\Logger\Logger</argument>
        </arguments>
    </type>
    <type name="Mercur\Connector\Model\Fulfillment\FulfillmentSync">
        <arguments>
            <argument name="logger" xsi:type="object">Mercur\Core\Logger\Logger</argument>
        </arguments>
    </type>
    <type name="Mercur\Connector\Model\Order\Synchronizer">
        <arguments>
            <argument name="logger" xsi:type="object">Mercur\Core\Logger\Logger</argument>
        </arguments>
    </type>
    <type name="Mercur\Connector\Model\Total\MarketplaceShipping">
        <arguments>
            <argument name="logger" xsi:type="object">Mercur\Core\Logger\Logger</argument>
        </arguments>
    </type>
    <type name="Magento\Sales\Model\Order\Item">
        <plugin name="mercur_lock_seller_shipping" type="Mercur\Connector\Plugin\Sales\LockSellerShipping"/>
    </type>
    <type name="Magento\Sales\Model\ResourceModel\Order\Handler\State">
        <plugin name="mercur_lift_shipment_lock" type="Mercur\Connector\Plugin\Sales\LiftShipmentLockForStateHandler"/>
    </type>
    <type name="Magento\Sales\Model\Order\OrderStateResolverInterface">
        <plugin name="mercur_lift_shipment_lock" type="Mercur\Connector\Plugin\Sales\LiftShipmentLockForStateResolver"/>
    </type>
    <type name="Magento\Quote\Model\Quote\Item\CartItemOptionsProcessor">
        <plugin name="mercur_add_offer_to_rest_buy_request" type="Mercur\Connector\Plugin\AddOfferToRestBuyRequest"/>
    </type>
    <type name="Magento\Shipping\Model\Shipping">
        <plugin name="mercur_exclude_marketplace_items_from_rates" type="Mercur\Connector\Plugin\ExcludeMarketplaceItemsFromRates"/>
    </type>
    <type name="Magento\Quote\Model\Quote\Item\ToOrderItem">
        <plugin name="mercur_copy_seller_label" type="Mercur\Connector\Plugin\CopySellerLabelToOrderItem"/>
    </type>
    <type name="Magento\CatalogInventory\Model\Quote\Item\QuantityValidator">
        <plugin name="mercur_skip_stock_validation_for_offers" type="Mercur\Connector\Plugin\SkipStockValidationForOffers"/>
    </type>
    <type name="Magento\CatalogInventory\Observer\SubtractQuoteInventoryObserver">
        <plugin name="mercur_skip_stock_deduction_for_offers" type="Mercur\Connector\Plugin\SkipStockDeductionForOffers"/>
    </type>
    <type name="Magento\CatalogInventory\Model\ResourceModel\Stock\Status">
        <plugin name="mercur_include_offered_products_in_status_filter" type="Mercur\Connector\Plugin\Stock\IncludeOfferedProductsInStatusFilter"/>
    </type>
    <type name="Magento\CatalogInventory\Helper\Stock">
        <plugin name="mercur_include_offered_products_in_helper_filter" type="Mercur\Connector\Plugin\Stock\IncludeOfferedProductsInHelperFilter"/>
    </type>
    <type name="Magento\CatalogSearch\Model\Indexer\Plugin\StockedProductsFilterPlugin">
        <plugin name="mercur_include_offered_products_in_fulltext" type="Mercur\Connector\Plugin\Search\IncludeOfferedProductsInFulltext"/>
    </type>
    <virtualType name="Mercur\Connector\Model\ResourceModel\Seller\Grid\Collection" type="Magento\Framework\View\Element\UiComponent\DataProvider\SearchResult">
        <arguments>
            <argument name="mainTable" xsi:type="string">mercur_seller</argument>
            <argument name="resourceModel" xsi:type="string">Mercur\Connector\Model\ResourceModel\Seller</argument>
        </arguments>
    </virtualType>
    <type name="Mercur\Connector\Model\ResourceModel\Offer\Grid\Collection">
        <arguments>
            <argument name="mainTable" xsi:type="string">mercur_offer</argument>
            <argument name="resourceModel" xsi:type="string">Mercur\Connector\Model\ResourceModel\Offer</argument>
        </arguments>
    </type>
    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="mercur_seller_listing_data_source" xsi:type="string">Mercur\Connector\Model\ResourceModel\Seller\Grid\Collection</item>
                <item name="mercur_offer_listing_data_source" xsi:type="string">Mercur\Connector\Model\ResourceModel\Offer\Grid\Collection</item>
            </argument>
        </arguments>
    </type>
    <virtualType name="Magento\Sales\Model\ResourceModel\Order\Grid">
        <arguments>
            <argument name="columns" xsi:type="array">
                <item name="mercur_order_group_id" xsi:type="string">sales_order.mercur_order_group_id</item>
            </argument>
        </arguments>
    </virtualType>
    <type name="Magento\Checkout\Model\ShippingInformationManagement">
        <plugin name="mercur_block_checkout_on_shipping_error" type="Mercur\Connector\Plugin\BlockCheckoutOnShippingError"/>
    </type>
    <type name="Magento\Checkout\Model\PaymentInformationManagement">
        <plugin name="mercur_block_checkout_on_shipping_error" type="Mercur\Connector\Plugin\BlockCheckoutOnShippingError"/>
    </type>
    <type name="Magento\Checkout\Model\GuestPaymentInformationManagement">
        <plugin name="mercur_block_checkout_on_shipping_error" type="Mercur\Connector\Plugin\BlockGuestCheckoutOnShippingError"/>
    </type>
    <type name="Magento\QuoteGraphQl\Model\Resolver\PlaceOrder">
        <plugin name="mercur_block_checkout_on_shipping_error" type="Mercur\Connector\Plugin\BlockCheckoutOnShippingError"/>
    </type>
    <type name="Magento\Quote\Model\Quote">
        <plugin name="mercur_reset_shadow_cart_on_merge" type="Mercur\Connector\Plugin\ResetShadowCartOnMerge"/>
    </type>
    <type name="Magento\SalesRule\Model\Validator">
        <plugin name="mercur_exclude_offer_items_from_discount" type="Mercur\Connector\Plugin\SalesRule\ExcludeOfferItemsFromDiscount"/>
    </type>
    <type name="Magento\SalesRule\Model\Rule\Condition\Product">
        <plugin name="mercur_exclude_offer_items_from_product_condition" type="Mercur\Connector\Plugin\SalesRule\ExcludeOfferItemsFromProductCondition"/>
    </type>
    <type name="Magento\SalesRule\Model\Rule\Condition\Address">
        <plugin name="mercur_operator_only_address_condition" type="Mercur\Connector\Plugin\SalesRule\OperatorOnlyAddressCondition"/>
    </type>
    <type name="Magento\SalesRule\Model\RulesApplier">
        <plugin name="mercur_skip_offer_items_in_rules_applier" type="Mercur\Connector\Plugin\SalesRule\SkipOfferItemsInRulesApplier"/>
    </type>
    <type name="Magento\Tax\Model\Sales\Total\Quote\Tax">
        <plugin name="mercur_add_seller_shipping_taxable" type="Mercur\Connector\Plugin\Tax\AddSellerShippingTaxable"/>
    </type>
</config>
