<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="mercur_seller" resource="default" engine="innodb" comment="Mercur Seller">
        <column xsi:type="varchar" name="seller_id" nullable="false" length="64" comment="Mercur seller ID"/>
        <column xsi:type="varchar" name="name" nullable="false" length="255" comment="Name"/>
        <column xsi:type="varchar" name="handle" nullable="false" length="255" comment="Handle"/>
        <column xsi:type="varchar" name="status" nullable="false" length="32" comment="Status"/>
        <column xsi:type="boolean" name="premium" nullable="false" default="false" comment="Premium"/>
        <column xsi:type="smallint" name="default_leadtime_to_ship" unsigned="true" nullable="true" comment="Default lead time"/>
        <column xsi:type="timestamp" name="closed_from" nullable="true" comment="Closed from"/>
        <column xsi:type="timestamp" name="closed_to" nullable="true" comment="Closed to"/>
        <column xsi:type="text" name="description" nullable="true" comment="Description"/>
        <column xsi:type="text" name="logo" nullable="true" comment="Logo URL"/>
        <column xsi:type="text" name="banner" nullable="true" comment="Banner URL"/>
        <column xsi:type="varchar" name="city" nullable="true" length="255" comment="City"/>
        <column xsi:type="varchar" name="country_code" nullable="true" length="2" comment="Country"/>
        <column xsi:type="timestamp" name="selling_since" nullable="true" comment="Mercur created at"/>
        <column xsi:type="timestamp" name="updated_at" nullable="true" comment="Mercur updated at"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="seller_id"/>
        </constraint>
        <index referenceId="MERCUR_SELLER_HANDLE" indexType="btree">
            <column name="handle"/>
        </index>
    </table>
    <table name="mercur_offer" resource="default" engine="innodb" comment="Mercur Offer">
        <column xsi:type="varchar" name="offer_id" nullable="false" length="64" comment="Mercur offer ID"/>
        <column xsi:type="varchar" name="product_sku" nullable="false" length="64" comment="Magento SKU"/>
        <column xsi:type="varchar" name="seller_sku" nullable="false" length="255" comment="Seller SKU"/>
        <column xsi:type="varchar" name="seller_id" nullable="false" length="64" comment="Mercur seller ID"/>
        <column xsi:type="varchar" name="mercur_product_id" nullable="true" length="64" comment="Mercur product ID"/>
        <column xsi:type="varchar" name="variant_id" nullable="false" length="64" comment="Mercur variant ID"/>
        <column xsi:type="varchar" name="shipping_profile_id" nullable="true" length="64" comment="Shipping profile ID"/>
        <column xsi:type="int" name="quantity" nullable="true" comment="Available quantity"/>
        <column xsi:type="boolean" name="allow_backorder" nullable="false" default="false" comment="Allow backorder"/>
        <column xsi:type="boolean" name="manage_inventory" nullable="false" default="true" comment="Manage inventory"/>
        <column xsi:type="smallint" name="leadtime_to_ship" unsigned="true" nullable="true" comment="Lead time to ship"/>
        <column xsi:type="varchar" name="condition_code" nullable="true" length="64" comment="Condition"/>
        <column xsi:type="varchar" name="condition_label" nullable="true" length="255" comment="Condition label"/>
        <column xsi:type="boolean" name="active" nullable="false" default="true" comment="Active"/>
        <column xsi:type="timestamp" name="updated_at" nullable="true" comment="Mercur updated at"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="offer_id"/>
        </constraint>
        <index referenceId="MERCUR_OFFER_PRODUCT_SKU" indexType="btree">
            <column name="product_sku"/>
        </index>
        <index referenceId="MERCUR_OFFER_SELLER_ID" indexType="btree">
            <column name="seller_id"/>
        </index>
    </table>
    <table name="mercur_offer_price" resource="default" engine="innodb" comment="Mercur offer price per website">
        <column xsi:type="varchar" name="offer_id" nullable="false" length="64" comment="Mercur offer ID"/>
        <column xsi:type="smallint" name="website_id" unsigned="true" nullable="false" comment="Website"/>
        <column xsi:type="varchar" name="currency_code" nullable="false" length="3" comment="Currency"/>
        <column xsi:type="decimal" name="price" scale="4" precision="20" nullable="false" comment="Price"/>
        <column xsi:type="decimal" name="origin_price" scale="4" precision="20" nullable="true" comment="Price before discount"/>
        <column xsi:type="text" name="price_ranges" nullable="true" comment="Quantity tier prices JSON"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="offer_id"/>
            <column name="website_id"/>
        </constraint>
        <index referenceId="MERCUR_OFFER_PRICE_WEBSITE_ID" indexType="btree">
            <column name="website_id"/>
        </index>
    </table>
    <table name="quote">
        <column xsi:type="varchar" name="mercur_cart_id" nullable="true" length="64" comment="Mercur shadow cart ID"/>
        <column xsi:type="text" name="mercur_shipping_methods" nullable="true" comment="Chosen Mercur shipping option per seller JSON"/>
        <column xsi:type="varchar" name="mercur_sync_hash" nullable="true" length="40" comment="Fingerprint of the last Mercur shipping quote"/>
    </table>
    <table name="quote_item">
        <column xsi:type="varchar" name="mercur_offer_id" nullable="true" length="64" comment="Mercur offer ID"/>
        <column xsi:type="varchar" name="mercur_seller_id" nullable="true" length="64" comment="Mercur seller ID"/>
        <column xsi:type="varchar" name="mercur_line_item_id" nullable="true" length="64" comment="Mercur line item ID"/>
    </table>
    <table name="quote_address">
        <column xsi:type="decimal" name="mercur_shipping_amount" scale="4" precision="20" nullable="true" comment="Marketplace shipping"/>
        <column xsi:type="decimal" name="base_mercur_shipping_amount" scale="4" precision="20" nullable="true" comment="Base marketplace shipping"/>
        <column xsi:type="decimal" name="mercur_shipping_tax_amount" scale="4" precision="20" nullable="true" comment="Marketplace shipping tax"/>
        <column xsi:type="decimal" name="base_mercur_shipping_tax_amount" scale="4" precision="20" nullable="true" comment="Base marketplace shipping tax"/>
        <column xsi:type="decimal" name="mercur_shipping_incl_tax" scale="4" precision="20" nullable="true" comment="Marketplace shipping incl. tax"/>
        <column xsi:type="decimal" name="base_mercur_shipping_incl_tax" scale="4" precision="20" nullable="true" comment="Base marketplace shipping incl. tax"/>
        <column xsi:type="varchar" name="mercur_shipping_error" nullable="true" length="255" comment="Why the marketplace shipping could not be quoted"/>
    </table>
    <table name="sales_order">
        <column xsi:type="varchar" name="mercur_cart_id" nullable="true" length="64" comment="Mercur shadow cart ID"/>
        <column xsi:type="varchar" name="mercur_order_group_id" nullable="true" length="64" comment="Mercur order group ID"/>
        <column xsi:type="decimal" name="mercur_shipping_amount" scale="4" precision="20" nullable="true" comment="Marketplace shipping"/>
        <column xsi:type="decimal" name="base_mercur_shipping_amount" scale="4" precision="20" nullable="true" comment="Base marketplace shipping"/>
        <column xsi:type="decimal" name="mercur_shipping_invoiced" scale="4" precision="20" nullable="true" comment="Marketplace shipping invoiced"/>
        <column xsi:type="decimal" name="base_mercur_shipping_invoiced" scale="4" precision="20" nullable="true" comment="Base marketplace shipping invoiced"/>
        <column xsi:type="decimal" name="mercur_shipping_refunded" scale="4" precision="20" nullable="true" comment="Marketplace shipping refunded"/>
        <column xsi:type="decimal" name="base_mercur_shipping_refunded" scale="4" precision="20" nullable="true" comment="Base marketplace shipping refunded"/>
        <column xsi:type="text" name="mercur_shipping_methods" nullable="true" comment="Chosen Mercur shipping option per seller JSON"/>
        <column xsi:type="decimal" name="mercur_shipping_tax_amount" scale="4" precision="20" nullable="true" comment="Marketplace shipping tax"/>
        <column xsi:type="decimal" name="base_mercur_shipping_tax_amount" scale="4" precision="20" nullable="true" comment="Base marketplace shipping tax"/>
        <column xsi:type="decimal" name="mercur_shipping_incl_tax" scale="4" precision="20" nullable="true" comment="Marketplace shipping incl. tax"/>
        <column xsi:type="decimal" name="base_mercur_shipping_incl_tax" scale="4" precision="20" nullable="true" comment="Base marketplace shipping incl. tax"/>
        <column xsi:type="timestamp" name="mercur_sent_at" nullable="true" comment="When the order was created in Mercur"/>
        <column xsi:type="timestamp" name="mercur_captured_at" nullable="true" comment="When the payment capture was confirmed to Mercur"/>
    </table>
    <table name="sales_order_item">
        <column xsi:type="varchar" name="mercur_offer_id" nullable="true" length="64" comment="Mercur offer ID"/>
        <column xsi:type="varchar" name="mercur_seller_id" nullable="true" length="64" comment="Mercur seller ID"/>
        <column xsi:type="varchar" name="mercur_line_item_id" nullable="true" length="64" comment="Mercur line item ID"/>
        <column xsi:type="varchar" name="mercur_order_id" nullable="true" length="64" comment="Mercur seller order ID"/>
        <column xsi:type="varchar" name="mercur_status" nullable="true" length="32" comment="Mercur fulfillment status"/>
        <column xsi:type="varchar" name="mercur_order_line_item_id" nullable="true" length="64" comment="Mercur seller order line item ID"/>
        <column xsi:type="varchar" name="mercur_cancel_reason" nullable="true" length="32" comment="Why the Mercur seller order line was canceled"/>
        <index referenceId="SALES_ORDER_ITEM_MERCUR_ORDER_ID" indexType="btree">
            <column name="mercur_order_id"/>
        </index>
    </table>
    <table name="sales_order_grid">
        <column xsi:type="varchar" name="mercur_order_group_id" nullable="true" length="64" comment="Mercur order group ID"/>
    </table>
    <table name="sales_invoice">
        <column xsi:type="decimal" name="mercur_shipping_amount" scale="4" precision="20" nullable="true" comment="Marketplace shipping"/>
        <column xsi:type="decimal" name="base_mercur_shipping_amount" scale="4" precision="20" nullable="true" comment="Base marketplace shipping"/>
        <column xsi:type="decimal" name="mercur_shipping_tax_amount" scale="4" precision="20" nullable="true" comment="Marketplace shipping tax"/>
        <column xsi:type="decimal" name="base_mercur_shipping_tax_amount" scale="4" precision="20" nullable="true" comment="Base marketplace shipping tax"/>
        <column xsi:type="decimal" name="mercur_shipping_incl_tax" scale="4" precision="20" nullable="true" comment="Marketplace shipping incl. tax"/>
        <column xsi:type="decimal" name="base_mercur_shipping_incl_tax" scale="4" precision="20" nullable="true" comment="Base marketplace shipping incl. tax"/>
    </table>
    <table name="sales_creditmemo">
        <column xsi:type="decimal" name="mercur_shipping_amount" scale="4" precision="20" nullable="true" comment="Marketplace shipping"/>
        <column xsi:type="decimal" name="base_mercur_shipping_amount" scale="4" precision="20" nullable="true" comment="Base marketplace shipping"/>
        <column xsi:type="decimal" name="mercur_shipping_tax_amount" scale="4" precision="20" nullable="true" comment="Marketplace shipping tax"/>
        <column xsi:type="decimal" name="base_mercur_shipping_tax_amount" scale="4" precision="20" nullable="true" comment="Base marketplace shipping tax"/>
        <column xsi:type="decimal" name="mercur_shipping_incl_tax" scale="4" precision="20" nullable="true" comment="Marketplace shipping incl. tax"/>
        <column xsi:type="decimal" name="base_mercur_shipping_incl_tax" scale="4" precision="20" nullable="true" comment="Base marketplace shipping incl. tax"/>
        <column xsi:type="varchar" name="mercur_refund_id" nullable="true" length="64" comment="Mercur refund ID"/>
        <column xsi:type="boolean" name="mercur_reported" nullable="false" default="false" comment="Already known to Mercur"/>
        <index referenceId="SALES_CREDITMEMO_MERCUR_REFUND_ID" indexType="btree">
            <column name="mercur_refund_id"/>
        </index>
    </table>
    <table name="sales_shipment">
        <column xsi:type="varchar" name="mercur_fulfillment_id" nullable="true" length="64" comment="Mercur fulfillment ID"/>
        <index referenceId="SALES_SHIPMENT_MERCUR_FULFILLMENT_ID" indexType="btree">
            <column name="mercur_fulfillment_id"/>
        </index>
    </table>
    <table name="mercur_webhook_event" resource="default" engine="innodb" comment="Mercur webhook deliveries already handled">
        <column xsi:type="varchar" name="event_id" nullable="false" length="64" comment="Delivery or event ID"/>
        <column xsi:type="varchar" name="event" nullable="false" length="64" comment="Event name"/>
        <column xsi:type="timestamp" name="received_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Received"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="event_id"/>
        </constraint>
        <index referenceId="MERCUR_WEBHOOK_EVENT_RECEIVED_AT" indexType="btree">
            <column name="received_at"/>
        </index>
    </table>
</schema>
