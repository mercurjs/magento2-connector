<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <mercur>
            <general>
                <enabled>0</enabled>
                <api_url>http://localhost:9000</api_url>
                <api_key backend_model="Magento\Config\Model\Config\Backend\Encrypted"/>
                <publishable_key backend_model="Magento\Config\Model\Config\Backend\Encrypted"/>
                <sales_channel_id/>
                <region_id/>
                <channel>magento</channel>
                <timeout>15</timeout>
                <retries>2</retries>
                <retry_delay_ms>500</retry_delay_ms>
                <log_level>errors</log_level>
            </general>
            <process>
                <timeout_sec>3600</timeout_sec>
                <history_days>30</history_days>
                <max_attempts>3</max_attempts>
            </process>
            <offers>
                <best_offer_rule>lowest_total_price</best_offer_rule>
                <operator_label>Sold by us</operator_label>
                <identifier_attributes/>
            </offers>
            <checkout>
                <shipping_prices_include_tax>0</shipping_prices_include_tax>
                <auto_remove_unavailable>1</auto_remove_unavailable>
            </checkout>
            <order>
                <auto_create_statuses>pending,processing</auto_create_statuses>
                <lock_seller_shipping>1</lock_seller_shipping>
            </order>
            <webhook>
                <secret backend_model="Magento\Config\Model\Config\Backend\Encrypted"/>
                <max_age_sec>0</max_age_sec>
            </webhook>
            <delivery>
                <enabled>1</enabled>
                <cutoff_time>14:00</cutoff_time>
                <business_days>1,2,3,4,5</business_days>
                <transit_days_min>1</transit_days_min>
                <transit_days_max>3</transit_days_max>
            </delivery>
            <sync>
                <sellers_cron>*/15 * * * *</sellers_cron>
                <offers_cron>*/5 * * * *</offers_cron>
                <products_cron>0 * * * *</products_cron>
                <full_cron>0 2 * * *</full_cron>
                <refunds_cron>*/15 * * * *</refunds_cron>
                <order_retry_cron>*/10 * * * *</order_retry_cron>
                <page_size>100</page_size>
            </sync>
        </mercur>
    </default>
</config>
