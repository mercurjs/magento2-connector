<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="mercur" translate="label" sortOrder="400">
            <label>Mercur</label>
        </tab>
        <section id="mercur" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Marketplace</label>
            <tab>mercur</tab>
            <resource>Mercur_Core::config_section</resource>
            <group id="general" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Connection</label>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="api_url" translate="label comment" type="text" sortOrder="20" showInDefault="1" showInWebsite="1">
                    <label>Mercur API URL</label>
                    <comment>Base URL of the Mercur API, for example https://api.example.com</comment>
                </field>
                <field id="api_key" translate="label comment" type="obscure" sortOrder="30" showInDefault="1" showInWebsite="1">
                    <label>Admin API key</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    <comment>A secret admin API key bound to a role that holds the integrations permission.</comment>
                </field>
                <field id="publishable_key" translate="label comment" type="obscure" sortOrder="40" showInDefault="1" showInWebsite="1">
                    <label>Publishable API key</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    <comment>Used for the shadow cart during checkout.</comment>
                </field>
                <field id="sales_channel_id" translate="label" type="text" sortOrder="50" showInDefault="1" showInWebsite="1">
                    <label>Mercur sales channel ID</label>
                </field>
                <field id="region_id" translate="label comment" type="text" sortOrder="60" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Mercur region ID</label>
                    <comment>The Mercur region whose prices this website shows.</comment>
                </field>
                <field id="timeout" translate="label" type="text" sortOrder="70" showInDefault="1">
                    <label>Request timeout (seconds)</label>
                    <validate>validate-digits</validate>
                </field>
            </group>
            <group id="offers" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1">
                <label>Offers</label>
                <field id="best_offer_rule" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1">
                    <label>Best offer rule</label>
                    <source_model>Mercur\Core\Model\Config\Source\BestOfferRule</source_model>
                </field>
                <field id="operator_label" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Label for your own stock</label>
                </field>
            </group>
            <group id="delivery" translate="label comment" type="text" sortOrder="25" showInDefault="1" showInWebsite="1">
                <label>Delivery estimates</label>
                <comment>Shown on seller offers, in the cart and at checkout. Lead time comes from the offer or the seller default.</comment>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1">
                    <label>Show estimated delivery</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="cutoff_time" translate="label comment" type="text" sortOrder="20" showInDefault="1" showInWebsite="1">
                    <label>Order cut-off time</label>
                    <comment>HH:MM in the store timezone. Orders after it count from the next business day.</comment>
                </field>
                <field id="business_days" translate="label" type="multiselect" sortOrder="30" showInDefault="1" showInWebsite="1">
                    <label>Business days</label>
                    <source_model>Mercur\Core\Model\Config\Source\Weekday</source_model>
                </field>
                <field id="transit_days_min" translate="label" type="text" sortOrder="40" showInDefault="1" showInWebsite="1">
                    <label>Minimum transit days</label>
                    <validate>validate-digits</validate>
                </field>
                <field id="transit_days_max" translate="label comment" type="text" sortOrder="50" showInDefault="1" showInWebsite="1">
                    <label>Maximum transit days</label>
                    <comment>A Mercur shipping option can override both through data.transit_days_min and data.transit_days_max.</comment>
                    <validate>validate-digits</validate>
                </field>
            </group>
            <group id="webhook" translate="label" type="text" sortOrder="30" showInDefault="1">
                <label>Webhooks</label>
                <field id="secret" translate="label comment" type="obscure" sortOrder="10" showInDefault="1">
                    <label>Signing secret</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    <comment>Shown once in Mercur when the endpoint is created. The endpoint URL is {base_url}/mercur/webhook.</comment>
                </field>
            </group>
            <group id="sync" translate="label" type="text" sortOrder="40" showInDefault="1">
                <label>Synchronisation</label>
                <field id="sellers_cron" translate="label" type="text" sortOrder="10" showInDefault="1">
                    <label>Sellers schedule (cron)</label>
                </field>
                <field id="offers_cron" translate="label" type="text" sortOrder="20" showInDefault="1">
                    <label>Offers delta schedule (cron)</label>
                </field>
                <field id="products_cron" translate="label" type="text" sortOrder="30" showInDefault="1">
                    <label>Published products schedule (cron)</label>
                </field>
                <field id="full_cron" translate="label" type="text" sortOrder="40" showInDefault="1">
                    <label>Full resync schedule (cron)</label>
                </field>
                <field id="refunds_cron" translate="label" type="text" sortOrder="45" showInDefault="1">
                    <label>Refund fallback schedule (cron)</label>
                </field>
                <field id="order_retry_cron" translate="label" type="text" sortOrder="46" showInDefault="1">
                    <label>Order retry schedule (cron)</label>
                </field>
                <field id="page_size" translate="label" type="text" sortOrder="50" showInDefault="1">
                    <label>Page size</label>
                    <validate>validate-digits</validate>
                </field>
            </group>
        </section>
    </system>
</config>
